# Writing (Phase 3, fake device). Tempo 120, so a beat is 500 ms; the
# script acts 250 ms away from any note, so the timing is never close.
# Messages reach the device whole; a full buffer is waited out (for up
# to 1 s) and a message written in pieces is finished; EINTR is
# retried; a buffer that stays full loses the port, keeping the
# tracks, and reopening carries on.
fakedev port 1 0 1
open device hw:1,0,0
track 1 60:1 62:1
play continue
sleep 250
fakedev log
# room for 2 bytes: beat 1's note-off goes out in pieces, waiting for
# room, then beat 1's note-on
fakedev room 2
sleep 500
fakedev drain
sleep 100
fakedev log
devdiag
# an interrupted write (beat 2) is retried
fakedev eintr
sleep 500
fakedev log
# no room at all from beat 3: after 1 s the port counts as lost
fakedev room 0
sleep 1500
state
devdiag
fakedev log
fakedev room all
open device hw:1,0,0
play continue
sleep 100
play stop
close
fakedev log
