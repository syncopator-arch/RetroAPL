  open controlC3: ok
  ioctl prefer-subdevice 0
  open midiC3D0 nonblock: ok
  ioctl info: subdevice 0
  close controlC3
  close midiC3D0 sub 0
# the cable comes back as card 4: the name finds it there
fakedev unplug 3
open device u2midi
  error: SEQ_ERR_PORT (MIDI port could not be opened)
fakedev port 4 0 1
fakedev name 4 U2MIDI Pro
open device u2midi
fakedev log
  open controlC1: ok
  close controlC1
  open controlC3: No such file or directory
  open controlC5: ok
  close controlC5
  open controlC1: ok
  close controlC1
  open controlC3: No such file or directory
  open controlC4: ok
