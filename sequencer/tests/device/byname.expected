# Opening a port by device name (Phase 8, fake device): the first port
# in the list whose label contains the name, ignoring case. Labels are
# plain ASCII (a byte outside 32..126 shows as ?), and a name is matched
# against the label as listed. No match is "no such port"; a malformed
# hw: name, or an empty one, is "not understood". The name is looked up
# again at every open, so a device that comes back as another card is
# found again, including when reopening after a lost port.
fakedev port 1 0 2
fakedev port 3 0 1
fakedev name 3 U2MIDI Pro
fakedev port 5 0 1
fakedev name 5 Caf\xe9 Synth
ports
  4 ports
  hw:1,0,0  Fake card 1 / Fake MIDI 0 / Fake MIDI 0-0
  hw:1,0,1  Fake card 1 / Fake MIDI 0 / Fake MIDI 0-1
  hw:3,0,0  U2MIDI Pro / Fake MIDI 0 / Fake MIDI 0-0
  hw:5,0,0  Caf? Synth / Fake MIDI 0 / Fake MIDI 0-0
# a name, in either case (the library folds A-Z itself)
open device u2midi
close
  closed: (none)
open device U2MIDI PRO
fakedev log
  open controlC1: ok
  close controlC1
  open controlC3: ok
  close controlC3
  open controlC5: ok
  close controlC5
  open controlC1: ok
  close controlC1
  open controlC3: ok
  close controlC3
  open controlC5: ok
  close controlC5
  open controlC3: ok
  ioctl prefer-subdevice 0
  open midiC3D0 nonblock: ok
  ioctl info: subdevice 0
  close controlC3
  close midiC3D0 sub 0
  open controlC1: ok
  close controlC1
  open controlC3: ok
  close controlC3
  open controlC5: ok
  close controlC5
  open controlC3: ok
  ioctl prefer-subdevice 0
  open midiC3D0 nonblock: ok
  ioctl info: subdevice 0
  close controlC3
close
  closed: (none)
# a subdevice's own name: the second port of card 1
open device midi 0-1
fakedev log
  close midiC3D0 sub 0
  open controlC1: ok
  close controlC1
  open controlC3: ok
  close controlC3
  open controlC5: ok
  close controlC5
  open controlC1: ok
  ioctl prefer-subdevice 1
  open midiC1D0 nonblock: ok
  ioctl info: subdevice 1
  close controlC1
close
  closed: (none)
# several match: the first in the list (hw:1,0,0)
open device fake
fakedev log
  close midiC1D0 sub 1
  open controlC1: ok
  close controlC1
  open controlC3: ok
  close controlC3
  open controlC5: ok
  close controlC5
  open controlC1: ok
  ioctl prefer-subdevice 0
  open midiC1D0 nonblock: ok
  ioctl info: subdevice 0
  close controlC1
close
  closed: (none)
# only the first match is tried: busy, though hw:1,0,1 is free
fakedev busy 1 0 0
open device fake
  error: SEQ_ERR_PORT_BUSY (MIDI port in use)
fakedev free 1 0 0
# ? in a name is only itself
open device caf? synth
close
  closed: (none)
open device caf?? synth
  error: SEQ_ERR_PORT (MIDI port could not be opened)
open device nothing like it
  error: SEQ_ERR_PORT (MIDI port could not be opened)
devdiag
  failed: find by name (no port with that name)
  writes 0, waited 0, subdevice -1
# the hw: form as before, now in either case; a malformed one
open device HW:3,0,0
close
  closed: (none)
open device hw:x
  error: SEQ_ERR_PORT_NAME (MIDI port name not understood)
open device
  error: SEQ_ERR_PORT_NAME (MIDI port name not understood)
