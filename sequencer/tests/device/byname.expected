  close controlC5
  open controlC4: ok
  ioctl prefer-subdevice 0
  open midiC4D0 nonblock: ok
  ioctl info: subdevice 0
  close controlC4
close
  closed: (none)
# no match while a card can't be read (no permission): that is the
# likelier reason, so "no permission" rather than "no such port"
fakedev deny 1
open device nothing like it
  error: SEQ_ERR_PORT_ACCESS (no permission for MIDI port)
devdiag
  failed: find by name (no port with that name, and a card was refused: no permission)
  writes 0, waited 0, subdevice -1
open device u2midi
close
  closed: (none)
# lost while playing, back as card 6: reopening by name finds it, and
# the held note is released there. Tempo 120, a beat is 500 ms; the
# port is lost at beat 2 by 45's note-off, with 60 still sounding.
open device u2midi
track 1 45:2 52:2
  takes over at beat 0.000 (t0)
track 2 60:4
  takes over at beat 0.000 (t0)
play continue
  was playing: 0
sleep 250
fakedev unplug 4
sleep 1000
