# Phase 8: the gate (seq_set_gate()), the fraction of its step a note
# with no length of its own sounds: (0, 1], default 1. Applies to notes
# started from then on; kept through new versions and seq_clear();
# reset at close. A note's own length takes precedence.
open virtual
state
  seq: STOPPED beat 0.000 (t0) tempo 120 tracks 0
gate 1 = 1/2
  prev: 1
state
  seq: STOPPED beat 0.000 (t0) tempo 120 tracks 0
# half of each step: 1-beat steps end at .5, the 1/3-beat step at 1/6
track 1 60:1 62:1 64:1/3 65:2/3
  takes over at beat 0.000 (t0)
play continue
  was playing: 0
runto 3
log
  0.000 t0 0.000ms ON  ch1 60 v100
  0.500 t1260 250.000ms OFF ch1 60
  1.000 t2520 500.000ms ON  ch1 62 v100
  1.500 t3780 750.000ms OFF ch1 62
  2.000 t5040 1000.000ms ON  ch1 64 v100
  2.167 t5460 1083.333ms OFF ch1 64
  2.333 t5880 1166.667ms ON  ch1 65 v100
  2.667 t6720 1333.333ms OFF ch1 65
# a note's own length wins over the gate; - takes the gate
track 1 60:1:-:3/4 62:1:-:-
  takes over at beat 3.000 (t7560)
runto 6
log
  3.000 t7560 1500.000ms ON  ch1 60 v100
  3.750 t9450 1875.000ms OFF ch1 60
  4.000 t10080 2000.000ms ON  ch1 62 v100
  4.500 t11340 2250.000ms OFF ch1 62
  5.000 t12600 2500.000ms ON  ch1 60 v100
  5.750 t14490 2875.000ms OFF ch1 60
# changed while a note sounds (62, started at beat 6 with the gate at
# 1/2): it keeps its note-off at 6.5; 60 at 7 has its own length; 62
# at 8 takes the new gate, 0.25 of its step
runto 6.25
gate 1 = 1/4
  prev: 0.5
runto 9
log
  6.000 t15120 3000.000ms ON  ch1 62 v100
  6.500 t16380 3250.000ms OFF ch1 62
  7.000 t17640 3500.000ms ON  ch1 60 v100
  7.750 t19530 3875.000ms OFF ch1 60
  8.000 t20160 4000.000ms ON  ch1 62 v100
  8.250 t20790 4125.000ms OFF ch1 62
# very small: at least one tick (62 at beat 10)
gate 1 = 1/100000
  prev: 0.25
runto 11
log
  9.000 t22680 4500.000ms ON  ch1 60 v100
  9.750 t24570 4875.000ms OFF ch1 60
  10.000 t25200 5000.000ms ON  ch1 62 v100
  10.000 t25201 5000.198ms OFF ch1 62
# kept through a new version and seq_clear(); several tracks at once,
# one value per track
clear 1
  held: 1
track 1 60:1
  takes over at beat 11.000 (t27720)
state
  seq: PLAYING beat 11.000 (t27720) tempo 120 tracks 1
  track 1: notes 2 ch 1 mute 0 loop 1 vel 100 length 2.000 (t5040) pending 1 position 0.000 (t0) gate 1e-05
gate 1 2 = 1 0.75
  prev: 1e-05 1
gate 1 2 = 0.3
  prev: 1 0.75
# errors, nothing changed: 0, over 1, negative, a bad track
gate 1 = 0
  error: SEQ_ERR_VALUE (value out of range)
gate 1 = 1.5
  error: SEQ_ERR_VALUE (value out of range)
gate 1 = -1/2
  error: SEQ_ERR_VALUE (value out of range)
gate 17 = 1/2
  error: SEQ_ERR_TRACK (track number out of range)
state
  seq: PLAYING beat 11.000 (t27720) tempo 120 tracks 1
  track 1: notes 2 ch 1 mute 0 loop 1 vel 100 length 2.000 (t5040) pending 1 position 0.000 (t0) gate 0.3
close
  closed: 1
# reset at close
open virtual
track 1 60:1
  takes over at beat 0.000 (t0)
state
  seq: STOPPED beat 0.000 (t0) tempo 120 tracks 1
  track 1: notes 0 ch 1 mute 0 loop 1 vel 100 length 0.000 (t0) pending 1 position 0.000 (t0)
gate 1 = 1/2
  prev: 1
close
  closed: 1
gate 1 = 1/2
  error: SEQ_ERR_NOT_OPEN (sequencer not open)
