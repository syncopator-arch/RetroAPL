# Phase 9: a track's notes read back out for a MIDI file
# (seq_get_track_notes()), each as play would send it: the velocity
# scaled by the track's, the note-off from its own length or the gate,
# never past the next note's start, its own channel or the track's.
# Rests are left out; the length is the whole pass.
open virtual
track 1:3 60:1:80:1/2 r:1/2 62:1:-:2 64:1/3:127:-:9 65:2/3
vel 1 = 50
gate 1 = 1/4
trackout 1
# Mute doesn't matter: a muted track's notes come out the same.
mute 1 = 1
trackout 1
# A track with nothing: no notes, length 0. A rest-only track: no
# notes, but its length.
trackout 2
track 3 r:5/2
trackout 3
# Which version: the waiting one while nothing plays on the track ...
play continue
runto 1
track 4 67:1
trackout 4
# ... the playing one once it plays, even with a newer one waiting.
runto 3
track 4 69:1/2 71:1/2 72:1
trackout 4
runto 4
trackout 4
# Errors
trackout 0
trackout 17
close
trackout 1
