# Phase 9: a track's notes read back out for a MIDI file
# (seq_get_track_notes()), each as play would send it: the velocity
# scaled by the track's, the note-off from its own length or the gate,
# never past the next note's start, its own channel or the track's.
# Rests are left out; the length is the whole pass.
open virtual
track 1:3 60:1:80:1/2 r:1/2 62:1:-:2 64:1/3:127:-:9 65:2/3
  takes over at beat 0.000 (t0)
vel 1 = 50
  prev: 100
gate 1 = 1/4
  prev: 1
trackout 1
  length 3.500 (t8820), 4 notes
  0.000 (t0) to 0.500 (t1260): 60 v40 ch3
  1.500 (t3780) to 2.500 (t6300): 62 v50 ch3
  2.500 (t6300) to 2.583 (t6510): 64 v64 ch9
  2.833 (t7140) to 3.000 (t7560): 65 v50 ch3
# Mute doesn't matter: a muted track's notes come out the same.
mute 1 = 1
  prev: 0
trackout 1
  length 3.500 (t8820), 4 notes
  0.000 (t0) to 0.500 (t1260): 60 v40 ch3
  1.500 (t3780) to 2.500 (t6300): 62 v50 ch3
  2.500 (t6300) to 2.583 (t6510): 64 v64 ch9
  2.833 (t7140) to 3.000 (t7560): 65 v50 ch3
# A track with nothing: no notes, length 0. A rest-only track: no
# notes, but its length.
trackout 2
  length 0.000 (t0), 0 notes
track 3 r:5/2
  takes over at beat 0.000 (t0)
trackout 3
  length 2.500 (t6300), 0 notes
# Which version: the waiting one while nothing plays on the track ...
play continue
  was playing: 0
runto 1
track 4 67:1
  takes over at beat 1.000 (t2520)
trackout 4
  length 1.000 (t2520), 1 note
  0.000 (t0) to 1.000 (t2520): 67 v100 ch4
# ... the playing one once it plays, even with a newer one waiting.
runto 3
track 4 69:1/2 71:1/2 72:1
  takes over at beat 3.000 (t7560)
trackout 4
  length 1.000 (t2520), 1 note
  0.000 (t0) to 1.000 (t2520): 67 v100 ch4
runto 4
trackout 4
  length 2.000 (t5040), 3 notes
  0.000 (t0) to 0.500 (t1260): 69 v100 ch4
  0.500 (t1260) to 1.000 (t2520): 71 v100 ch4
  1.000 (t2520) to 2.000 (t5040): 72 v100 ch4
# Errors
trackout 0
  error: SEQ_ERR_TRACK (track number out of range)
trackout 17
  error: SEQ_ERR_TRACK (track number out of range)
close
  closed: 1 3 4
trackout 1
  error: SEQ_ERR_NOT_OPEN (sequencer not open)
